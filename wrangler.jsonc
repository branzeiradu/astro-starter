{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-25",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "astro-starter",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"logs": {
		"enabled": true,
		"head_sampling_rate": 1,
		"persist": true,
		"invocation_logs": true
	},
	"traces": {
		"enabled": true,
		"persist": true,
		"head_sampling_rate": 1
	}
}