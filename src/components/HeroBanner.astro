---
export interface HeroBannerProps {
  title: string;
  subtitle: string;
  mediaAsset: {
    url: string;
    contentType: string;
  };
  titlePosition: string;
  subTitlePosition: string;
}

interface Props {
  bannerData: HeroBannerProps;
}

const { bannerData } = Astro.props;


// 1. Destructure with safe, component-level default fallbacks
const {
  title = bannerData.title,
  subtitle = bannerData.title,
  mediaAsset,
  titlePosition = bannerData.titlePosition,
  subTitlePosition = bannerData.subTitlePosition,
} = bannerData || {} as HeroBannerProps;


// THE FIX: We bundle Box Placement, Flex Alignment, and Text Justification 
// into a single cohesive rule. They will never fight or cancel each other out again.
const layoutMap: Record<string, string> = {
  'top-left': 'row-start-1 justify-self-start self-start text-left items-start',
  'top-center': 'row-start-1 justify-self-center self-start text-center items-center',
  'top-right': 'row-start-1 justify-self-end self-start text-right items-end',
  
  'center-left': 'row-start-2 justify-self-start self-center text-left items-start',
  'center-center': 'row-start-2 justify-self-center self-center text-center items-center',
  'center-right': 'row-start-2 justify-self-end self-center text-right items-end',
  
  'bottom-left': 'row-start-3 justify-self-start self-end text-left items-start',
  'bottom-center': 'row-start-3 justify-self-center self-end text-center items-center',
  'bottom-right': 'row-start-3 justify-self-end self-end text-right items-end',
};

const titleClasses = layoutMap[titlePosition] || layoutMap['top-left'];
const subtitleClasses = layoutMap[subTitlePosition] || layoutMap['bottom-right'];

const isVideo = mediaAsset?.contentType?.startsWith('video/');

console.log("Title Position: " + titlePosition);
console.log("Sub Title Position: " + subTitlePosition);

const positionsMatch = titlePosition === subTitlePosition;
---

<section class="relative w-full h-[85vh] min-h-[550px] max-h-[900px] overflow-hidden bg-slate-950 select-none">
  
  <div class="absolute inset-0 w-full h-full z-0">
    {isVideo ? (
      <video src={mediaAsset?.url} autoplay loop muted playsinline class="w-full h-full object-cover" />
    ) : (
      <img src={mediaAsset?.url} alt={title || 'Hero Background'} class="w-full h-full object-cover" loading="eager" />
    )}
    <div class="absolute inset-0 bg-slate-950/30 z-10"></div>
  </div>

  <div class="absolute inset-0 z-20 w-full h-full max-w-[1432px] mx-auto p-8 md:p-16 grid grid-cols-1 grid-rows-3 gap-4 pointer-events-none">
    
    {positionsMatch ? (
      <div class:list={[
        "max-w-full flex flex-col gap-4 pointer-events-auto",
        titleClasses // Controls the container alignment and text alignment of both simultaneously
      ]}>
        {title && <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)] leading-[1.1]">{title}</h1>}
        {subtitle && <p class="text-base sm:text-lg md:text-xl text-slate-200 font-semibold drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)] leading-snug">{subtitle}</p>}
      </div>
    ) : (
      <>
        {title && (
          <div class:list={["max-w-full flex flex-col pointer-events-auto", titleClasses]}>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.5)] leading-[1.1]">{title}</h1>
          </div>
        )}
        
        {subtitle && (
          <div class:list={["max-w-full flex flex-col pointer-events-auto", subtitleClasses]}>
            <p class="text-base sm:text-lg md:text-xl text-slate-200 font-semibold drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)] leading-snug">{subtitle}</p>
          </div>
        )}
      </>
    )}

  </div>
</section>